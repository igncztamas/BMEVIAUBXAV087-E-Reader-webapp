@inherits LayoutComponentBase
@implements IDisposable
@inject UserSessionService Session
@inject EbookApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="app-shell @(IsReaderPage ? "is-reader" : "")">
    @if (IsReaderPage)
    {
        <div class="top-bar-hover-zone"></div>
    }
    <header class="navbar">
        <a class="navbar-brand" href="/">@(Session.IsAuthenticated ? Session.HeaderTitle : "E-book Reader")</a>
        <nav class="navbar-links">
            <button class="btn btn-outline btn-sm" @onclick="ToggleDarkModeAsync" title="Toggle Dark Mode">@(Session.IsDarkMode ? "☀️ Light" : "🌙 Dark")</button>
            @if (Session.IsAuthenticated && Session.CurrentUser is not null)
            {
                <span>Logged in as: <strong>@Session.CurrentUser.Username</strong></span>
                <a class="btn btn-outline btn-sm" href="/">My Library</a>
                <button class="btn btn-outline btn-sm" @onclick="HandleLogoutAsync">Logout</button>
            }
            else
            {
                <a class="btn btn-outline btn-sm" href="/login">Login</a>
                <a class="btn btn-primary btn-sm" href="/register">Register</a>
            }
        </nav>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

@code {
    private bool IsReaderPage => Navigation.Uri.Contains("/reader/", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += StateHasChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        await Session.EnsureInitializedAsync();
        try
        {
            await JS.InvokeVoidAsync("ebookTheme.apply", Session.IsDarkMode);
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("ebookTheme.apply", Session.IsDarkMode);
        }
        catch { }
    }

    private async Task ToggleDarkModeAsync()
    {
        Session.ToggleDarkMode();
        try
        {
            await JS.InvokeVoidAsync("ebookTheme.apply", Session.IsDarkMode);
        }
        catch { }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogoutAsync()
    {
        await ApiClient.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
