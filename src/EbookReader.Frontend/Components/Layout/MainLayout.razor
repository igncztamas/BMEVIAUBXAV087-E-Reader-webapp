@inherits LayoutComponentBase
@implements IDisposable
@inject UserSessionService Session
@inject EbookApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="app-shell @(IsReaderPage ? "is-reader" : "")">
    @* Auto-hide hover activation zone for reader mode navbar *@
    @if (IsReaderPage)
    {
        <div class="top-bar-hover-zone"></div>
    }

    @* Global top navigation bar *@
    <header class="navbar">
        <a class="navbar-brand" href="/">@(Session.IsAuthenticated ? Session.HeaderTitle : "E-book Reader")</a>
        <nav class="navbar-links">
            <button class="btn btn-outline btn-sm" @onclick="ToggleDarkModeAsync" title="Toggle Dark Mode">@(Session.IsDarkMode ? "☀️ Light" : "🌙 Dark")</button>
            @if (Session.IsAuthenticated && Session.CurrentUser is not null)
            {
                <span>Logged in as: <strong>@Session.CurrentUser.Username</strong></span>
                <a class="btn btn-outline btn-sm" href="/">My Library</a>
                <button class="btn btn-outline btn-sm" @onclick="HandleLogoutAsync">Logout</button>
            }
            else
            {
                <a class="btn btn-outline btn-sm" href="/login">Login</a>
                <a class="btn btn-primary btn-sm" href="/register">Register</a>
            }
        </nav>
    </header>

    @* Main body workspace stage *@
    <main class="app-main">
        @Body
    </main>
</div>

@code {
    /// <summary>
    /// Indicates whether the active route corresponds to the e-book reader page.
    /// </summary>
    private bool IsReaderPage => Navigation.Uri.Contains("/reader/", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Initializes session event subscriptions and synchronizes client-side dark theme.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += StateHasChanged;
        Navigation.LocationChanged += HandleLocationChanged;

        // Ensure session credentials are recovered from browser storage
        await Session.EnsureInitializedAsync();
        try
        {
            await JS.InvokeVoidAsync("ebookTheme.apply", Session.IsDarkMode);
        }
        catch
        {
            // Ignore JS interop failures during prerendering
        }
    }

    /// <summary>
    /// Applies active theme styles to client DOM after interactive server rendering is established.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("ebookTheme.apply", Session.IsDarkMode);
        }
        catch
        {
            // Ignore JS errors on disconnect
        }
    }

    /// <summary>
    /// Toggles the dark mode setting and propagates the change to the DOM.
    /// </summary>
    private async Task ToggleDarkModeAsync()
    {
        Session.ToggleDarkMode();
        try
        {
            await JS.InvokeVoidAsync("ebookTheme.apply", Session.IsDarkMode);
        }
        catch
        {
            // Ignore JS interop errors
        }
    }

    /// <summary>
    /// Triggers re-rendering on route changes to re-evaluate reader vs standard layout rules.
    /// </summary>
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Performs user logout via API client and redirects to the login view.
    /// </summary>
    private async Task HandleLogoutAsync()
    {
        await ApiClient.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    /// <summary>
    /// Cleans up event subscriptions to prevent memory leaks.
    /// </summary>
    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
