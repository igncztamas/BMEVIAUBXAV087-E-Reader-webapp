@page "/"
@page "/library"
@implements IDisposable
@inject UserSessionService Session
@inject EbookApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>My Library – E-book Reader</PageTitle>

@if (Session.IsAuthenticated)
{
    <div class="workspace-split" style="display: flex; flex-direction: row; width: 100%; height: 100%; overflow: hidden;">
        <div class="workspace-main" style="flex: 1; height: 100%; overflow-y: auto;">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <div class="alert alert-success" role="status">@_successMessage</div>
            }

            @if (_books.Count == 0)
            {
                <div class="card" style="text-align: center; color: var(--muted); padding: 2.5rem;">
                    You have no uploaded books yet. Upload a PDF or EPUB file on the right!
                </div>
            }
            else
            {
                <div class="book-grid">
                    @foreach (var book in _books)
                    {
                        <div class="card" style="margin-bottom: 0; display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: start; gap: 0.5rem;">
                                    <h3 style="margin: 0 0 0.35rem 0; font-size: 1.15rem;">@book.Title</h3>
                                    <span class="badge">@book.Format</span>
                                </div>
                                <p style="margin: 0 0 0.75rem 0; font-size: 0.85rem; color: var(--muted);">
                                    @(string.IsNullOrWhiteSpace(book.Author) ? book.FileName : book.Author) (@FormatSize(book.FileSizeBytes))
                                </p>
                                <p style="margin: 0 0 0.35rem 0; font-size: 0.92rem;">
                                    Reading position: <strong>Page @book.CurrentPage / @book.TotalPages</strong>
                                </p>
                                <p style="margin: 0 0 1rem 0; font-size: 0.85rem; color: var(--muted);">
                                    Bookmarks: @book.BookmarkCount
                                </p>
                            </div>

                            <div style="display: flex; gap: 0.5rem;">
                                <a class="btn btn-primary btn-sm" style="flex: 1;" href="/reader/@book.Id">
                                    📖 Open (Page @book.CurrentPage)
                                </a>
                                <button class="btn btn-danger btn-sm" @onclick="() => HandleDeleteBookAsync(book.Id)">
                                    Delete
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <aside class="right-sidebar" style="width: 320px; flex-shrink: 0; height: 100%; overflow-y: auto; margin-left: auto;">
            <div class="card" style="margin-bottom: 0;">
                <h2 style="margin-top: 0; font-size: 1.15rem;">Upload New E-book (PDF / EPUB)</h2>
                <div class="form-group">
                    <label for="book-title">Book Title (optional)</label>
                    <input id="book-title" class="form-control" @bind="_customTitle" />
                </div>
                <div class="form-group">
                    <label for="book-file">Select Files (.pdf, .epub – max. 10 MB each)</label>
                    <InputFile id="book-file" OnChange="HandleFileSelectedAsync" class="form-control" multiple />
                </div>
                <button class="btn btn-primary" style="width: 100%;" @onclick="HandleUploadSelectedFilesAsync" disabled="@(_selectedFiles.Count == 0 || _isBusy)">
                    Upload
                </button>
            </div>
        </aside>
    </div>
}

@code {
    private List<BookSummaryItemDto> _books = new();
    private string? _customTitle;
    private List<(string Name, byte[] Bytes)> _selectedFiles = new();
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        Session.SetHeaderTitle("My Library");
        Session.OnChange += HandleSessionChanged;
        await Session.EnsureInitializedAsync();
        if (!Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadBooksAsync();
    }

    private async void HandleSessionChanged()
    {
        if (Session.IsAuthenticated)
        {
            await LoadBooksAsync();
        }
        else
        {
            _books.Clear();
            Navigation.NavigateTo("/login");
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadBooksAsync()
    {
        Session.SetHeaderTitle("My Library");
        var result = await ApiClient.GetBooksAsync();
        if (result.IsSuccess && result.Data is not null)
        {
            _books = result.Data;
        }
        else if (!result.IsSuccess)
        {
            _errorMessage = result.ErrorMessage;
        }
    }

    private async Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _selectedFiles.Clear();
        _errorMessage = null;
        _successMessage = null;

        var errors = new List<string>();
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(maximumFileCount: 50);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error selecting files: {ex.Message}";
            return;
        }

        foreach (var file in files)
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 12 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                _selectedFiles.Add((file.Name, ms.ToArray()));
            }
            catch (Exception ex)
            {
                errors.Add($"{file.Name}: {ex.Message}");
            }
        }

        if (errors.Count > 0)
        {
            _errorMessage = string.Join(" | ", errors);
        }
    }

    private async Task HandleUploadSelectedFilesAsync()
    {
        if (_selectedFiles.Count == 0)
        {
            _errorMessage = "Please select a file first!";
            return;
        }

        _errorMessage = null;
        _successMessage = null;
        _isBusy = true;

        var uploadedTitles = new List<string>();
        var errors = new List<string>();
        BookDetailItemDto? lastUploadedBook = null;

        try
        {
            var singleCustomTitle = _selectedFiles.Count == 1 ? _customTitle : null;

            foreach (var item in _selectedFiles)
            {
                try
                {
                    var result = await ApiClient.UploadBookAsync(item.Name, item.Bytes, singleCustomTitle);
                    if (result.IsSuccess && result.Data is not null)
                    {
                        lastUploadedBook = result.Data;
                        uploadedTitles.Add(result.Data.Title);
                    }
                    else
                    {
                        errors.Add($"{item.Name}: {result.ErrorMessage ?? "Failed to upload file."}");
                    }
                }
                catch (Exception ex)
                {
                    errors.Add($"{item.Name}: {ex.Message}");
                }
            }

            if (uploadedTitles.Count == 1 && lastUploadedBook is not null)
            {
                _successMessage = $"Successfully uploaded: '{lastUploadedBook.Title}' ({lastUploadedBook.Format}, {lastUploadedBook.TotalPages} pages).";
            }
            else if (uploadedTitles.Count > 1)
            {
                _successMessage = $"Successfully uploaded {uploadedTitles.Count} books: {string.Join(", ", uploadedTitles)}.";
            }

            if (errors.Count > 0)
            {
                _errorMessage = string.Join(" | ", errors);
            }

            _selectedFiles.Clear();
            _customTitle = null;
            await LoadBooksAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleDeleteBookAsync(Guid bookId)
    {
        _errorMessage = null;
        _successMessage = null;

        var result = await ApiClient.DeleteBookAsync(bookId);
        if (result.IsSuccess)
        {
            _successMessage = "Book deleted from your library.";
            await LoadBooksAsync();
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Failed to delete book.";
        }
    }

    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024.0:F1} KB";

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }
}
