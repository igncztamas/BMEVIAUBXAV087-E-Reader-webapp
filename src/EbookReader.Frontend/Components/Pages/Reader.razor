@page "/reader/{BookId:guid}"
@inject UserSessionService Session
@inject EbookApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Reader – E-book Reader</PageTitle>

@if (!Session.IsAuthenticated)
{
    <div style="padding: 2rem; width: 100%;">
        <div class="alert alert-danger" role="alert">
            You must be logged in to use the reader. <a href="/login">Login here!</a>
        </div>
    </div>
}
else if (_isLoading)
{
    <div style="padding: 2rem; width: 100%;">
        <div class="card">Loading book...</div>
    </div>
}
else if (_book is null)
{
    <div style="padding: 2rem; width: 100%;">
        <div class="alert alert-danger" role="alert">
            @(_errorMessage ?? "The book could not be loaded.")
        </div>
        <a class="btn btn-outline" href="/">← Back to Library</a>
    </div>
}
else
{
    <div class="workspace-split">
        @if (_showToc)
        {
            <TocSidebar TableOfContents="_book.TableOfContents"
                        CurrentPage="_currentPage"
                        OnCollapse="ToggleToc"
                        OnNavigateToPage="JumpToBackendPageAsync" />
        }

        <div class="reader-main-stage" style="position: relative;">
            @if (!_showToc)
            {
                <button class="btn btn-outline btn-sm"
                        style="position: absolute; top: 0.75rem; left: 0.75rem; z-index: 20; background: var(--surface); box-shadow: 0 2px 6px rgba(0,0,0,0.1);"
                        @onclick="ToggleToc">
                    📑 Contents
                </button>
            }
            <div id="ebook-render-target" class="reader-page-box"></div>
        </div>

        <ReaderControlsSidebar Format="@_book.Format"
                               CurrentPage="_currentPage"
                               TotalPages="_totalPages"
                               SubPage="_epubSubPage"
                               SubPageCount="_epubSubPageCount"
                               ZoomLevel="_zoomLevel"
                               Bookmarks="_bookmarks"
                               ErrorMessage="@_errorMessage"
                               StatusMessage="@_statusMessage"
                               OnPreviousPage="PreviousPageAsync"
                               OnNextPage="NextPageAsync"
                               OnJumpToPage="JumpToBackendPageAsync"
                               OnChangeZoom="ChangeZoomAsync"
                               OnResetZoom="ResetZoomAsync"
                               OnCreateBookmark="HandleCreateBookmarkAsync"
                               OnDeleteBookmark="HandleDeleteBookmarkAsync"
                               OnNavigateToPage="JumpToBackendPageAsync" />
    </div>
}

@code {
    [Parameter]
    public Guid BookId { get; set; }

    private sealed record RenderPageResult(int SubPage, int SubPageCount);

    private BookDetailItemDto? _book;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _epubSubPage = 1;
    private int _epubSubPageCount = 1;
    private int _requestedSubPage = 1;
    private string _currentPageContent = string.Empty;
    private List<BookmarkItemDto> _bookmarks = new();
    private string? _errorMessage;
    private string? _statusMessage;
    private bool _isLoading = true;
    private bool _needsJsRender;
    private int _zoomLevel = 100;
    private bool _showToc = true;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureInitializedAsync();
        if (!Session.IsAuthenticated)
        {
            _isLoading = false;
            return;
        }

        await LoadBookAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsJsRender && _book is not null)
        {
            _needsJsRender = false;
            var fileUrl = $"/api/books/{BookId}/file?token={Uri.EscapeDataString(Session.Token ?? string.Empty)}";
            try
            {
                var renderResult = await JS.InvokeAsync<RenderPageResult?>("ebookRenderer.renderPage", new
                {
                    targetId = "ebook-render-target",
                    bookId = BookId.ToString(),
                    format = _book.Format,
                    fileUrl,
                    pageNumber = _currentPage,
                    subPage = _requestedSubPage,
                    fallbackHtml = _currentPageContent,
                    zoomLevel = _zoomLevel
                });

                if (renderResult is not null && (_epubSubPage != renderResult.SubPage || _epubSubPageCount != renderResult.SubPageCount))
                {
                    _epubSubPage = renderResult.SubPage;
                    _epubSubPageCount = renderResult.SubPageCount;
                    StateHasChanged();
                }
            }
            catch
            {
                // Fallback HTML is already in DOM
            }
        }
    }

    private async Task LoadBookAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await ApiClient.GetBookDetailAsync(BookId);
        if (result.IsSuccess && result.Data is not null)
        {
            _book = result.Data;
            _currentPage = _book.CurrentPage;
            _totalPages = _book.TotalPages;
            _requestedSubPage = 1;
            _epubSubPage = 1;
            _epubSubPageCount = 1;
            _currentPageContent = _book.CurrentPageContent;
            _bookmarks = _book.Bookmarks.OrderBy(b => b.PageNumber).ToList();
            _zoomLevel = _book.ZoomLevel > 0 ? _book.ZoomLevel : 100;
            Session.SetHeaderTitle(_book.Title);
            _needsJsRender = true;
        }
        else
        {
            _book = null;
            _errorMessage = result.ErrorMessage ?? "Failed to load book.";
        }

        _isLoading = false;
    }

    private async Task PreviousPageAsync()
    {
        if (_book?.Format == "EPUB" && _epubSubPage > 1)
        {
            var res = await JS.InvokeAsync<RenderPageResult?>("ebookRenderer.setEpubSubPage", _epubSubPage - 1);
            if (res is not null)
            {
                _epubSubPage = res.SubPage;
                _epubSubPageCount = res.SubPageCount;
                _requestedSubPage = _epubSubPage;
            }
            StateHasChanged();
            return;
        }

        if (_currentPage > 1)
        {
            _requestedSubPage = -1;
            await NavigateToPageAsync(_currentPage - 1);
        }
    }

    private async Task NextPageAsync()
    {
        if (_book?.Format == "EPUB" && _epubSubPage < _epubSubPageCount)
        {
            var res = await JS.InvokeAsync<RenderPageResult?>("ebookRenderer.setEpubSubPage", _epubSubPage + 1);
            if (res is not null)
            {
                _epubSubPage = res.SubPage;
                _epubSubPageCount = res.SubPageCount;
                _requestedSubPage = _epubSubPage;
            }
            StateHasChanged();
            return;
        }

        if (_currentPage < _totalPages)
        {
            _requestedSubPage = 1;
            await NavigateToPageAsync(_currentPage + 1);
        }
    }

    private Task JumpToBackendPageAsync(int targetPage)
    {
        _requestedSubPage = 1;
        return NavigateToPageAsync(targetPage);
    }

    private void ToggleToc()
    {
        _showToc = !_showToc;
        _needsJsRender = true;
        StateHasChanged();
    }

    private async Task ChangeZoomAsync(int delta)
    {
        var newZoom = Math.Clamp(_zoomLevel + delta, 50, 250);
        if (newZoom != _zoomLevel)
        {
            _zoomLevel = newZoom;
            _requestedSubPage = _epubSubPage;
            _needsJsRender = true;
            await ApiClient.UpdateProgressAsync(BookId, _currentPage, DateTimeOffset.UtcNow, _zoomLevel);
        }
    }

    private async Task ResetZoomAsync()
    {
        if (_zoomLevel != 100)
        {
            _zoomLevel = 100;
            _requestedSubPage = _epubSubPage;
            _needsJsRender = true;
            await ApiClient.UpdateProgressAsync(BookId, _currentPage, DateTimeOffset.UtcNow, _zoomLevel);
        }
    }

    private async Task NavigateToPageAsync(int targetPage)
    {
        _errorMessage = null;
        _statusMessage = null;

        var pageResult = await ApiClient.GetBookPageAsync(BookId, targetPage);
        if (!pageResult.IsSuccess || pageResult.Data is null)
        {
            _errorMessage = pageResult.ErrorMessage ?? "Failed to load page.";
            return;
        }

        _currentPage = pageResult.Data.PageNumber;
        _totalPages = pageResult.Data.TotalPages;
        _currentPageContent = pageResult.Data.Content;

        await ApiClient.UpdateProgressAsync(BookId, _currentPage, DateTimeOffset.UtcNow, _zoomLevel);

        _needsJsRender = true;
        StateHasChanged();
    }

    private async Task HandleCreateBookmarkAsync(string bookmarkName)
    {
        _errorMessage = null;
        _statusMessage = null;

        var nameToSave = string.IsNullOrWhiteSpace(bookmarkName)
            ? $"Bookmark (Page {_currentPage})"
            : bookmarkName.Trim();

        var result = await ApiClient.AddBookmarkAsync(BookId, nameToSave, _currentPage);
        if (result.IsSuccess && result.Data is not null)
        {
            _bookmarks.Add(result.Data);
            _bookmarks = _bookmarks.OrderBy(b => b.PageNumber).ToList();
            _statusMessage = $"Bookmark saved: '{result.Data.Name}' (Page {result.Data.PageNumber}).";
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Failed to create bookmark.";
        }
    }

    private async Task HandleDeleteBookmarkAsync(Guid bookmarkId)
    {
        _errorMessage = null;
        _statusMessage = null;

        var result = await ApiClient.DeleteBookmarkAsync(BookId, bookmarkId);
        if (result.IsSuccess)
        {
            _bookmarks.RemoveAll(b => b.Id == bookmarkId);
            _statusMessage = "Bookmark deleted.";
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Failed to delete bookmark.";
        }
    }
}
