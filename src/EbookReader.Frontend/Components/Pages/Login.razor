@page "/login"
@inject UserSessionService Session
@inject EbookApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Login – E-book Reader</PageTitle>

@* Centered single-card auth container *@
<div class="auth-page">
    <div class="card auth-card">
        <h1>Login</h1>

        @* Error alert message banner *@
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }

        @* Username and password fields *@
        <div class="form-group">
            <label for="login-username">Username</label>
            <input id="login-username" class="form-control" @bind="_username" />
        </div>

        <div class="form-group">
            <label for="login-password">Password</label>
            <input id="login-password" type="password" class="form-control" @bind="_password" />
        </div>

        <button class="btn btn-primary" style="width: 100%;" @onclick="HandleLoginAsync" disabled="@_isSubmitting">
            @(_isSubmitting ? "Logging in..." : "Login")
        </button>

        @* Link to register page *@
        <p style="margin-top: 1rem; text-align: center; font-size: 0.9rem;">
            Don't have an account? <a href="/register">Register here!</a>
        </p>
    </div>
</div>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _isSubmitting;

    /// <summary>
    /// Checks if a session already exists and redirects authenticated users to the library.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitializedAsync();
        if (Session.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    /// <summary>
    /// Submits login credentials to the backend API.
    /// </summary>
    private async Task HandleLoginAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var result = await ApiClient.LoginAsync(_username, _password);
            if (result.IsSuccess)
            {
                // Navigate to the library dashboard upon successful login
                Navigation.NavigateTo("/");
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Login failed.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to connect to server: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
